<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:padding="8dp">

    <!-- شاشة العرض -->
    <TextView
        android:id="@+id/displayTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#ffffff"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="end"
        android:padding="16dp"
        android:background="#16213e"
        android:minHeight="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

    <!-- الصف الأول من الأزرار المتقدمة -->
    <Button
        android:id="@+id/btnSin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="sin"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/displayTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCos"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnCos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="cos"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/displayTextView"
        app:layout_constraintStart_toEndOf="@id/btnSin"
        app:layout_constraintEnd_toStartOf="@id/btnTan"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnTan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="tan"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/displayTextView"
        app:layout_constraintStart_toEndOf="@id/btnCos"
        app:layout_constraintEnd_toStartOf="@id/btnLog"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnLog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="log"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/displayTextView"
        app:layout_constraintStart_toEndOf="@id/btnTan"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- الصف الثاني من الأزرار المتقدمة -->
    <Button
        android:id="@+id/btnLn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ln"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnSin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSqrt"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnSqrt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="√"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnCos"
        app:layout_constraintStart_toEndOf="@id/btnLn"
        app:layout_constraintEnd_toStartOf="@id/btnPow"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnPow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="x^y"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnTan"
        app:layout_constraintStart_toEndOf="@id/btnSqrt"
        app:layout_constraintEnd_toStartOf="@id/btnFactorial"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnFactorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="n!"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/btnLog"
        app:layout_constraintStart_toEndOf="@id/btnPow"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- الصف الثالث - أزرار التحكم والثوابت -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#e94560"
        app:layout_constraintTop_toBottomOf="@id/btnLn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnBackspace"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnBackspace"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="⌫"
        android:textSize="18sp"
        android:backgroundTint="#e94560"
        app:layout_constraintTop_toBottomOf="@id/btnSqrt"
        app:layout_constraintStart_toEndOf="@id/btnClear"
        app:layout_constraintEnd_toStartOf="@id/btnPi"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnPi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="π"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnPow"
        app:layout_constraintStart_toEndOf="@id/btnBackspace"
        app:layout_constraintEnd_toStartOf="@id/btnE"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnE"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="e"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnFactorial"
        app:layout_constraintStart_toEndOf="@id/btnPi"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- صف الأرقام 7-8-9 والقسمة -->
    <Button
        android:id="@+id/btn7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="7"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btnClear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn8"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="8"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btnBackspace"
        app:layout_constraintStart_toEndOf="@id/btn7"
        app:layout_constraintEnd_toStartOf="@id/btn9"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="9"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btnPi"
        app:layout_constraintStart_toEndOf="@id/btn8"
        app:layout_constraintEnd_toStartOf="@id/btnDivide"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnDivide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="÷"
        android:textSize="20sp"
        android:backgroundTint="#0f3460"
        app:layout_constraintTop_toBottomOf="@id/btnE"
        app:layout_constraintStart_toEndOf="@id/btn9"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- صف الأرقام 4-5-6 والضرب -->
    <Button
        android:id="@+id/btn4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="4"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn5"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="5"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn8"
        app:layout_constraintStart_toEndOf="@id/btn4"
        app:layout_constraintEnd_toStartOf="@id/btn6"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="6"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn9"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintEnd_toStartOf="@id/btnMultiply"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnMultiply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="×"
        android:textSize="20sp"
        android:backgroundTint="#0f3460"
        app:layout_constraintTop_toBottomOf="@id/btnDivide"
        app:layout_constraintStart_toEndOf="@id/btn6"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- صف الأرقام 1-2-3 والطرح -->
    <Button
        android:id="@+id/btn1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn2"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn5"
        app:layout_constraintStart_toEndOf="@id/btn1"
        app:layout_constraintEnd_toStartOf="@id/btn3"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="3"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn6"
        app:layout_constraintStart_toEndOf="@id/btn2"
        app:layout_constraintEnd_toStartOf="@id/btnSubtract"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnSubtract"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="−"
        android:textSize="20sp"
        android:backgroundTint="#0f3460"
        app:layout_constraintTop_toBottomOf="@id/btnMultiply"
        app:layout_constraintStart_toEndOf="@id/btn3"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- صف 0 والنقطة والإشارة والجمع -->
    <Button
        android:id="@+id/btnPlusMinus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+/-"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn0"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btn0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn2"
        app:layout_constraintStart_toEndOf="@id/btnPlusMinus"
        app:layout_constraintEnd_toStartOf="@id/btnDot"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnDot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="."
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btn3"
        app:layout_constraintStart_toEndOf="@id/btn0"
        app:layout_constraintEnd_toStartOf="@id/btnAdd"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="+"
        android:textSize="20sp"
        android:backgroundTint="#0f3460"
        app:layout_constraintTop_toBottomOf="@id/btnSubtract"
        app:layout_constraintStart_toEndOf="@id/btnDot"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

    <!-- زر النسبة المئوية والمساواة -->
    <Button
        android:id="@+id/btnPercent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="%"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btnPlusMinus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEquals"
        android:layout_margin="4dp"/>

    <Button
        android:id="@+id/btnEquals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="="
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#4ecca3"
        app:layout_constraintTop_toBottomOf="@id/btn0"
        app:layout_constraintStart_toEndOf="@id/btnPercent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="4dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
